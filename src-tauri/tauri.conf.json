{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ubtech-alpha-1s",
  "version": "0.1.0",
  "identifier": "net.endkind.ubtech-alpha-1s",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ubtech Alpha 1S",
        "width": 1280,
        "height": 720,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Starting ...",
        "url": "splashscreen.html",
        "width": 420,
        "height": 200,
        "center": true,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#18181b",
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
